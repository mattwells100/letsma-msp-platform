# ============================================================
# LETSMA MSP PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to source control.
# ============================================================

# --- Core app ---
APP_NAME="Letsma MSP Platform"
APP_SECRET_KEY="change-this-to-a-long-random-string"
DATABASE_URL="sqlite:///./letsma_msp.db"
ADMIN_EMAIL="admin@letsma.co.uk"
ADMIN_PASSWORD="ChangeMe123!"
BASE_URL="http://localhost:8000"

# --- Microsoft Entra ID / Microsoft Graph (O365 license management) ---
# Register an app in Entra ID admin center -> API permissions (Application):
#   Organization.Read.All, User.Read.All, Directory.Read.All (admin consent required)
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# --- Xero (invoicing) ---
# Create an app at https://developer.xero.com/app/manage
# Redirect URI must be: {BASE_URL}/auth/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:8000/auth/xero/callback"
XERO_SCOPES="offline_access accounting.transactions accounting.contacts accounting.settings"

# --- WhatsApp Business Cloud API (Meta) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_VERIFY_TOKEN="letsma-verify-token"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Microsoft Teams ---
# Incoming webhook URL for a channel (Teams > Channel > Connectors > Incoming Webhook)
TEAMS_INCOMING_WEBHOOK_URL=""
# Shared secret configured on the Teams "outgoing webhook" used to validate HMAC signatures
TEAMS_OUTGOING_WEBHOOK_SECRET=""
# Azure Bot Service / Microsoft Bot Framework app registration
# Set the bot messaging endpoint to: {BASE_URL}/api/teams/messages
TEAMS_BOT_APP_ID=""
TEAMS_BOT_APP_SECRET=""
TEAMS_BOT_TENANT_ID=""
# Teams Phone call record import. Requires Graph application permissions:
#   CallRecords.Read.All, User.Read.All (admin consent required)
TEAMS_CALLS_TENANT_ID=""
TEAMS_CALLS_CLIENT_ID=""
TEAMS_CALLS_CLIENT_SECRET=""
TEAMS_CALLS_SYNC_ENABLED="false"
TEAMS_CALLS_AUTO_TICKETS_ENABLED="false"
TEAMS_CALLS_TICKET_MISSED_CALLS_ENABLED="true"
TEAMS_CALLS_TICKET_MIN_DURATION_SECONDS="0"

# --- Infinigate/Vuzion Marketplace API ---
# Provisioning remains disabled unless explicitly set to true.
VUZION_CLOUDBLUE_ENABLED="false"
VUZION_CLOUDBLUE_BASE_URL="https://api.vuzion.cloud/marketplace"
VUZION_CLOUDBLUE_SUBSCRIPTION_KEY=""
VUZION_CLOUDBLUE_USERNAME=""
VUZION_CLOUDBLUE_PASSWORD=""
VUZION_CLOUDBLUE_MARKETPLACE="gb"

# --- Endpoint monitoring agent ---
AGENT_API_KEY="letsma-agent-shared-key"
AGENT_OFFLINE_THRESHOLD_MINUTES=15
